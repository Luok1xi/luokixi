{
  "name": "luokixi",
  "private": true,
  "version": "0.3.1",
  "description": "面向矿大的校园、资料、校圈与开源创作社区",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node scripts/build-community.mjs",
    "data:offline": "node scripts/build-community.mjs --offline",
    "validate": "node scripts/validate-content.mjs",
    "map:data": "node scripts/build-campus-map.mjs",
    "test:materials": "node --test scripts/test-material-bag.mjs",
    "test:client": "node --test scripts/test-hub-client.mjs",
    "test:motion": "node --test scripts/test-carousel-motion.mjs",
    "test:projects": "node --test scripts/test-project-catalogue.mjs",
    "test:planner": "node --test scripts/test-campus-plan.mjs scripts/test-campus-store.mjs scripts/test-campus-import.mjs scripts/test-campus-route.mjs scripts/test-campus-merge.mjs scripts/test-campus-geometry.mjs scripts/test-course-board.mjs scripts/test-schedule-yield.mjs",
    "test:learning": "node --test scripts/test-learning-catalog.mjs scripts/test-private-resources.mjs",
    "test:university": "node --test scripts/test-university-catalogue.mjs",
    "robot:university": "python campus/university_sources_robot.py --download",
    "robot:reclassify": "python campus/university_sources_robot.py --reclassify-only --reextract"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@uppy/core": "5.2.0",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.64.0",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
